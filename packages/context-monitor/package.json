{
  "name": "@aeriondyseti/context-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Per-session context-usage monitor for Claude Code (single-script plugin).",
  "type": "module",
  "scripts": {
    "build": "esbuild src/context-monitor.ts --bundle --platform=node --target=node20 --format=esm --outfile=hooks/context-monitor.mjs --legal-comments=none --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@aeriondyseti/plugin-kit": "^2.3.0"
  }
}
